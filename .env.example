# Copy this file to .env and fill in your values
# cp .env.example .env

# MongoDB connection string
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/<dbName>

# JWT signing secret — use a long random string (min 32 chars)
JWT_SECRET=your_jwt_secret_here

# ImageKit private key — from your ImageKit dashboard
IMAGEKIT_PRIVATE_KEY=private_xxxxxxxxxxxx

# Node environment: development | production
NODE_ENV=development

# Port (optional, defaults to 3000)
PORT=3000

# Frontend origin for CORS (optional, defaults to http://localhost:5173)
CLIENT_URL=http://localhost:5173

# SMTP Email configuration (optional - logs reset link to console if omitted)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="RBAS Support" <no-reply@rbas.app>
